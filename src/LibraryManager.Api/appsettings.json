{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "Audience": "library-manager-api"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=library_manager;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Testing": {
    "UseTestAuth": false
  },
  "Outbox": {
    "ProcessorEnabled": true,
    "BatchSize": 10,
    "LeaseSeconds": 30,
    "PollIntervalMilliseconds": 2000,
    "MaxBackoffSeconds": 60
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
